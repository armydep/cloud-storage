{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(uv:*)",
      "Bash(bun:*)",
      "Bash(bunx:*)",
      "Bash(docker compose:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git push)",
      "Bash(git push origin:*)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(docker compose down -v:*)",
      "Bash(uv run alembic downgrade:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.p12)",
      "Edit(./.claude/settings.json)",
      "Edit(./frontend/src/client/**)",
      "Edit(./frontend/src/routeTree.gen.ts)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cp -n .env.example .env 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
