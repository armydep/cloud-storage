# Copy this file to `.env` before starting the stack:
#
#   cp .env.example .env
#
# `.env` is ignored by Git. Keep real secrets there, never in this file.
# Every value marked `changethis` MUST be replaced for staging and production:
# the backend only warns about them when ENVIRONMENT=local, and refuses to
# start otherwise.

# Domain
# This would be set to the production domain with an env var on deployment
# used by Traefik to transmit traffic and aqcuire TLS certificates
DOMAIN=localhost
# To test the local Traefik config
# DOMAIN=localhost.tiangolo.com

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:5173
# In staging and production, set this env var to the frontend host, e.g.
# FRONTEND_HOST=https://dashboard.example.com

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="Cloud File Storage"
STACK_NAME=cloud-file-storage

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis
BACKEND_WORKERS=4
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true

# RabbitMQ
RABBITMQ_USER=notifications
RABBITMQ_PASSWORD=changethis

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Object storage (MinIO locally, any S3-compatible endpoint elsewhere)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://minio:9000
# S3_PUBLIC_ENDPOINT_URL is used to generate download URLs for clients
# For local development: http://localhost:9000 (default)
# For mobile/remote access: set to the server's actual IP, e.g. http://192.168.1.100:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=cloud-file-storage
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_CONNECT_TIMEOUT_SECONDS=3
S3_READ_TIMEOUT_SECONDS=30
S3_MAX_ATTEMPTS=3

SENTRY_DSN=
METRICS_BEARER_TOKEN=changethis

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
